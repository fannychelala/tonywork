generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

model SystemProbe {
  id String @id

  @@map("system_probe")
}

model User {
  id               String       @id @db.Uuid
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)
  platformRole     String       @default("USER")
  twoFactorEnabled Boolean      @default(false)
  sessions         Session[]
  accounts         Account[]
  memberships      Membership[]
  twoFactors       TwoFactor[]

  @@map("auth_user")
}

model Session {
  id        String   @id @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("auth_verification")
}

model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  secret                  String
  backupCodes             String
  userId                  String    @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  @@index([userId])
  @@map("auth_two_factor")
}

model AuthMail {
  id        String   @id @default(uuid()) @db.Uuid
  recipient String
  kind      String
  url       String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("auth_mail")
}

model Organization {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  defaultLocale String       @default("fr-FR")
  currency      String       @default("EUR")
  timeZone      String       @default("Europe/Paris")
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  memberships   Membership[]
  contacts Contact[]
  serviceTemplates ServiceTemplate[]
  opportunities Opportunity[]
  tasks Task[]

  @@map("organization")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@map("membership")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @db.Uuid
  actorId        String   @db.Uuid
  event          String
  targetId       String?
  correlationId  String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

model Contact {
 organizationId String @db.Uuid
 id String @default(uuid()) @db.Uuid
 name String
 phone String
 email String?
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 version Int @default(1)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 opportunities Opportunity[]
 @@id([organizationId,id])
 @@unique([organizationId,phone])
 @@index([organizationId,name,id], map: "contact_name")
 @@map("contact")
}
model ServiceTemplate {
 organizationId String @db.Uuid
 id String @default(uuid()) @db.Uuid
 name String
 description String?
 currency String
 averageAmountMinor Int?
 minAmountMinor Int?
 maxAmountMinor Int?
 durationMinutes Int?
 active Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 version Int @default(1)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 opportunities Opportunity[]
 @@id([organizationId,id])
 @@index([organizationId,active,name,id], map: "service_active_name")
 @@map("service_template")
}
model Opportunity {
 organizationId String @db.Uuid
 id String @default(uuid()) @db.Uuid
 contactId String @db.Uuid
 serviceTemplateId String? @db.Uuid
 title String
 description String?
 status String @default("NEW")
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 version Int @default(1)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 contact Contact @relation(fields: [organizationId,contactId], references: [organizationId,id], onDelete: Restrict)
 serviceTemplate ServiceTemplate? @relation(fields: [organizationId,serviceTemplateId], references: [organizationId,id], onDelete: Restrict)
 tasks Task[]
 @@id([organizationId,id])
 @@index([organizationId,status,createdAt,id], map: "opportunity_status_date")
 @@index([organizationId,contactId], map: "opportunity_contact")
 @@index([organizationId,serviceTemplateId], map: "opportunity_service")
 @@map("opportunity")
}
model Task {
 organizationId String @db.Uuid
 id String @default(uuid()) @db.Uuid
 opportunityId String @db.Uuid
 title String
 dueAt DateTime? @db.Timestamptz(6)
 status String @default("OPEN")
 completedAt DateTime? @db.Timestamptz(6)
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 version Int @default(1)
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
 opportunity Opportunity @relation(fields: [organizationId,opportunityId], references: [organizationId,id], onDelete: Restrict)
 @@id([organizationId,id])
 @@index([organizationId,status,dueAt,id], map: "task_status_due")
 @@index([organizationId,opportunityId], map: "task_opportunity")
 @@map("task")
}
