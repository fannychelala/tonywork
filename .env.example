# Local only. Never reuse these credentials outside development.
DATABASE_URL=postgresql://tony_app:local_app_only@localhost:5432/tony
MIGRATION_DATABASE_URL=postgresql://tony_migrator:local_migrator_only@localhost:5432/tony
AUTH_DATABASE_URL=postgresql://tony_auth:local_auth_only@localhost:5432/tony
BETTER_AUTH_URL=http://127.0.0.1:3000
AUTH_MAIL_MODE=local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_GENERATED_SECRET
